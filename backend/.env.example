# Local development uses SQLite (zero setup):
DATABASE_URL="file:./dev.db"

# For production (PostgreSQL) set the datasource provider to "postgresql"
# in prisma/schema.prisma and use a connection string like:
# DATABASE_URL="postgresql://user:password@host:5432/taskly?schema=public"

PORT=4000
CORS_ORIGINS="http://localhost:3000"
